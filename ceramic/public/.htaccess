# Apache SPA fallback for the standalone ceramic micro-site.
# Deployed at /ceramic/ — all non-file requests should load the ceramic app shell.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ceramic/

  # One domain, one sitemap and one robots file, both at the site root.
  RewriteRule ^sitemap\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^robots\.txt$ /robots.txt [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
