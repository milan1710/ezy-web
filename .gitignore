.DS_Store
Thumbs.db

# Vite cache
.vite/

# Environment variables
#
# `.env` IS committed on purpose: it only holds the public Meta Pixel id, so the
# pixel keeps working when the site is built from this repository.
# NEVER put real secrets (passwords, private API keys) in `.env` - keep those in
# `.env.local` (ignored) or in your hosting dashboard's environment variables.
.env.local
.env.*.local
