# ---------------------------------------------------------------------------
# EzyDigital website environment variables
#
# IMPORTANT: this file IS committed to git, because the only value in it is a
# public Meta Pixel id - it keeps the pixel working when the site is built from
# the repository. NEVER add real secrets (passwords, private API keys) here.
# Put those in `.env.local` (gitignored) or in your hosting dashboard.
#
# Only VITE_ prefixed variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Meta (Facebook) Pixel ID.
# Leave the value empty to disable pixel tracking completely.
VITE_FB_PIXEL_ID=2673882233043263
