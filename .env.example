# ---------------------------------------------------------------------------
# Template for local environment variables.
# Copy this file to `.env` and fill in the values, or set the same variables in
# your hosting dashboard for production builds.
# ---------------------------------------------------------------------------

# Meta (Facebook) Pixel ID for the main website.
#
# The site loads exactly one pixel, and its base code / fbq('init') call lives in
# `src/utils/analytics.js`. Replace the value to install a different pixel; leave
# it empty to disable pixel tracking completely.
VITE_FB_PIXEL_ID=
